{
  "manifest_version": 3,
  "name": "Tab Fanfare",
  "version": "1.0.0",
  "description": "Plays a short cinematic \"ta-dum\" whenever you open a new tab.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["fanfare.js", "background.js"]
  },
  "action": {
    "default_title": "Tab Fanfare: on (click to mute)",
    "default_icon": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-fanfare@jithomas.mozilla.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
